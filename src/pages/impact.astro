---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import YearsStrip from '../components/YearsStrip.astro';
import Pending from '../components/Pending.astro';
import { campaign, history, photo } from '../lib/campaign.js';
---
<Base title="Impact" current="impact"
  description="Five years of the Patel Brothers’ Toy Drive: photos and results from past drives.">
  <div class="wrap page-head">
    <p class="eyebrow">Impact</p>
    <h1>What you’ve <span class="mark">made possible</span></h1>
    <p class="lead" style="margin-top:14px;max-width:60ch">
      {campaign.finalToyCount
        ? `This year: ${campaign.finalToyCount.toLocaleString('en-US')} toys. Thank you.`
        : `This is our ${campaign.edition} drive. This year’s total will be added here when the drive ends.`}
    </p>
  </div>

  <section style="padding-top:28px">
    <div class="wrap">
      <div class="sec-head"><h2>Five years, same three signs</h2></div>
      <YearsStrip />
    </div>
  </section>

  <Pending k="history" label="Years, totals and photos below come from last year’s website. They stay off the public site until you confirm them.">
    <section class="soft">
      <div class="wrap">
        <div class="sec-head"><h2>Past drives</h2><p class="muted">Results from previous years.</p></div>
        <div class="timeline">
          {history.years.map((y) => (
            <article class="yr">
              <Image src={photo(y.photo)} alt={y.alt} width={800} height={533} fit="cover" loading="lazy" />
              <div>
                <p class="eyebrow" style="margin-bottom:4px">{y.year}</p>
                <p class="n">{y.headline}</p>
                {y.note && <p class="muted" style="margin:6px 0 0">{y.note}</p>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </Pending>

  <Pending k="lastYearPhotos" label="Gallery photos are from last year’s website and need your approval.">
    <section>
      <div class="wrap">
        <div class="sec-head"><h2>From shopping cart to store shelf</h2><p class="muted">Select any photo to see it larger.</p></div>
        <div class="gallery">
          {history.gallery.map(async (g, i) => {
            const src = photo(g.photo);
            const full = await getImage({ src, width: 1600 });
            return (
              <button type="button" style={`--r:${(src.width / src.height).toFixed(3)}`} data-lightbox={full.src} data-caption={g.alt} data-index={i} aria-label={`Enlarge photo: ${g.alt}`}>
                <Image src={src} alt={g.alt} width={800} loading="lazy" />
              </button>
            );
          })}
        </div>
      </div>
    </section>
    <dialog class="lightbox" aria-label="Photo viewer">
      <img alt="" />
      <p></p>
      <div class="lb-nav">
        <button class="btn sm" type="button" data-lb="prev">Previous</button>
        <button class="btn sm" type="button" data-lb="next">Next</button>
        <button class="btn sm" type="button" data-lb="close">Close</button>
      </div>
    </dialog>
  </Pending>

  <Band heading="Help make this year the biggest yet" />

  <script>
    const dlg = document.querySelector('dialog.lightbox');
    const items = [...document.querySelectorAll('[data-lightbox]')];
    if (dlg && items.length) {
      const img = dlg.querySelector('img');
      const cap = dlg.querySelector('p');
      let i = 0;
      const show = (n) => {
        i = (n + items.length) % items.length;
        img.src = items[i].dataset.lightbox;
        img.alt = items[i].dataset.caption;
        cap.textContent = items[i].dataset.caption;
      };
      items.forEach((b, n) => b.addEventListener('click', () => { show(n); dlg.showModal(); }));
      dlg.addEventListener('click', (e) => {
        const a = e.target.closest('[data-lb]')?.dataset.lb;
        if (a === 'prev') show(i - 1);
        else if (a === 'next') show(i + 1);
        else if (a === 'close' || e.target === dlg) dlg.close();
      });
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(i - 1);
        if (e.key === 'ArrowRight') show(i + 1);
      });
    }
  </script>
</Base>
