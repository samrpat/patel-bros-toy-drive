---
import Base from '../layouts/Base.astro';
import { href } from '../lib/campaign.js';
---
<Base title="Page not found" sticky={false}>
  <section class="center">
    <div class="wrap">
      <h1>We couldn’t find that page</h1>
      <p class="lead" style="margin:16px 0 22px">The link may be old or mistyped.</p>
      <a class="btn primary" href={href('/')}>Go to the home page</a>
    </div>
  </section>
</Base>
